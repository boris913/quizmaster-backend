# Application
PORT=3001
NODE_ENV=development
# CORS : origine(s) autorisées du frontend, séparées par des virgules, sans "/" final.
# S'applique à l'API HTTP et à Socket.io. Si absente : http://localhost:3000 (dev).
# En production, OBLIGATOIRE : ex. https://quizmaster.example.fr,https://www.quizmaster.example.fr
# (FRONTEND_URL reste lue à défaut, pour compatibilité, mais est dépréciée.)
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
