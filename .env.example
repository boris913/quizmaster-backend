# Application
PORT=3001
NODE_ENV=development
# CORS : origine(s) autorisées du frontend, séparées par des virgules, sans "/" final.
# S'applique à l'API HTTP et à Socket.io. Si absente : http://localhost:3000 (dev).
# En production, OBLIGATOIRE : ex. https://kwizora.example.fr,https://www.kwizora.example.fr
# (FRONTEND_URL reste lue à défaut, pour compatibilité, mais est dépréciée.)
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Génération de quiz par IA (issue #11) — clé uniquement côté serveur.
# Sans clé, l'application démarre normalement et POST /api/quizzes/generate répond 503.
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut : claude-sonnet-5-5 ; claude-haiku-5-5 pour réduire le coût).
AI_MODEL=
# Générations autorisées par enseignant et par mois civil UTC (défaut : 3).
AI_MONTHLY_QUOTA=
# Facultatif : délai d'attente d'un appel IA en millisecondes (défaut : 120000).
AI_TIMEOUT_MS=
